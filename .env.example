# Local development overrides. All values are intentionally blank.
# Production secrets MUST be injected by the platform secrets manager (for
# example AWS Secrets Manager, GCP Secret Manager, or Vault), never committed.
# Docker Compose reads this file automatically after you copy it from
# .env.example; never commit a filled-in .env file.

# Some names below are reserved for later phases and are not read by the
# current services yet; they are listed so the template stays stable.

# Deployment
APP_ENV=
LOG_LEVEL=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis
REDIS_PASSWORD=
REDIS_URL=

# FastAPI
# CORS is derived from APP_URL, which compose maps from NEXT_PUBLIC_APP_URL; there is no separate CORS-origin variable.

# Next.js web
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_URL=
# Server-only key used by Next.js route handlers; never prefix with NEXT_PUBLIC_.
GATEWAY_API_KEY=

# Upstream HTTP client and Redis socket timeouts (seconds)
HTTP_CONNECT_TIMEOUT=
HTTP_READ_TIMEOUT=

# Inference limits (Phase 4; enforced by FastAPI on /v1)
# Maximum output tokens a request may ask for; default 4096.
MAX_OUTPUT_TOKENS=
# Maximum accepted request body size in bytes; default 1048576 (1 MiB).
MAX_REQUEST_BYTES=
# Per-API-key sliding-window request rate; default 60 requests/minute.
RATE_LIMIT_REQUESTS_PER_MINUTE=
# Per-API-key cap on concurrent in-flight /v1 requests; default 8.
RATE_LIMIT_MAX_CONCURRENT=
# Credit reservation hold lifetime in seconds; default 900 (15 minutes).
RESERVATION_TTL_SECONDS=

# Auth and API keys
JWT_SECRET=
# HS256 is pinned in code; any other JWT_ALGORITHM value fails startup.
JWT_ALGORITHM=
JWT_ISSUER=
JWT_AUDIENCE=
# Access-token TTL in minutes, enforced by the auth service: 5..1440, default 60.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
API_KEY_PEPPER=
# The API key prefix is fixed to sk_live_ in code; there is no env override.

# LiteLLM (master key is shared only with the API service)
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=
LITELLM_LOG=
# Provider credentials are injected into the LiteLLM container only, from the
# secrets manager, and referenced with `os.environ/...` in infra/litellm/config.yaml.
# They are deliberately not listed here.

# Billing / spend controls
# The per-user monthly cap is stored in users.spend_cap_monthly_microcredits
# (BIGINT, default 0 = disabled). It is not an environment variable.
SPEND_ALERT_THRESHOLD_MICROCREDITS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Email provider
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Sentry / OpenTelemetry
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=

# Worker
WORKER_QUEUE_NAME=
WORKER_MAX_JOBS=
WORKER_JOB_TIMEOUT_SECONDS=
WORKER_RESULT_TTL_SECONDS=
WORKER_LOG_LEVEL=

# Integration tests only (disposable Postgres; never production)
TEST_DATABASE_URL=
