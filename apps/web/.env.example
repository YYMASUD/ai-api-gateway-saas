# Copy to `.env.local` and adjust for your machine. Never commit real values.
# This URL is bundled into the browser, so it must not contain credentials.
# The typed client checks gateway liveness at GET /healthz on this base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only. Leave empty unless a route handler needs to call the gateway
# with an operator credential; never prefix this with NEXT_PUBLIC_.
GATEWAY_API_KEY=
